<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Receipt</title>

  <style>
    @page {
      size: A4 portrait;
      margin: 24px;
    }

    @media print {
      body {
        margin: 0;
      }
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-white font-sans">

  <!-- EJS Calculations -->
  <%
    const baseAmount = Number(amount || 0);
    const gst = Math.round(baseAmount * 0.18);
    const totalWithGst = baseAmount + gst;
  %>

  <div class="min-h-[100vh] w-full flex justify-center">
    <div class="w-full max-w-4xl border border-gray-200 p-10 flex flex-col justify-between">

      <!-- Top Section -->
      <div>
        <!-- Header -->
        <div class="flex justify-between items-center border-b pb-6 mb-6">
          <div class="flex items-center gap-3">
            <img src="http://localhost:3000/public/images/logoclipath.png" class="h-14" />
            <div>
              <h1 class="text-2xl font-bold text-orange-600">Techrover Solutions</h1>
              <p class="text-sm text-gray-500">Rover Receipt System</p>
            </div>
          </div>

          <div class="text-right text-sm">
            <p><span class="font-semibold">Receipt No:</span> <%= receiptNo %></p>
            <p><span class="font-semibold">Date:</span> <%= date %></p>
          </div>
        </div>

        <!-- Customer Info -->
        <div class="grid grid-cols-2 gap-6 text-sm mb-8">
          <div>
            <p class="text-gray-500">Billed To</p>
            <p class="font-semibold text-gray-800"><%= name %></p>
          </div>

          <div class="text-right">
            <p class="text-gray-500">Payment Mode</p>
            <p class="font-semibold text-gray-800"><%= type %></p>
          </div>
        </div>

        <!-- Amount Table -->
        <table class="w-full text-sm border border-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="text-left p-3 border-b">Description</th>
              <th class="text-right p-3 border-b">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3 border-b">Training Fees</td>
              <td class="p-3 text-right border-b">₹<%= baseAmount %></td>
            </tr>
            <tr>
              <td class="p-3 border-b">GST (18%)</td>
              <td class="p-3 text-right border-b">₹<%= gst %></td>
            </tr>
          </tbody>
        </table>

        <!-- Total -->
        <div class="flex justify-end mt-8">
          <div class="w-80 border-t pt-4 text-sm space-y-2">
            <div class="flex justify-between">
              <span class="text-gray-600">Subtotal</span>
              <span>₹<%= baseAmount %></span>
            </div>

            <div class="flex justify-between">
              <span class="text-gray-600">GST (18%)</span>
              <span>₹<%= gst %></span>
            </div>

            <div class="flex justify-between items-center pt-2 border-t">
              <span class="font-semibold">Total Paid</span>
              <span class="font-bold text-xl text-orange-600">₹<%= totalWithGst %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="text-center text-xs text-gray-500 border-t pt-4">
        This is a system-generated receipt. No signature required.  
        <br />
        Thank you for your business!
      </div>

    </div>
  </div>

</body>
</html>
